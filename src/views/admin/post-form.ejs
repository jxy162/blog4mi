<div class="admin-page-head editor-page-head">
  <div>
    <a class="back-link" href="/admin/posts"><svg><use href="/assets/images/icons.svg#icon-chevron-left"></use></svg> 返回文章</a>
    <h1><%= post ? '编辑文章' : '写新文章' %></h1>
    <p><%= post ? '修改内容后记得保存。' : '先把想法写下来，格式可以稍后再整理。' %></p>
  </div>
  <div class="editor-head-actions">
    <% if (post) { %><a class="button button-quiet" href="/posts/<%= post.slug %>" target="_blank" rel="noopener">预览文章 <svg><use href="/assets/images/icons.svg#icon-external"></use></svg></a><% } %>
    <button class="button button-primary" type="submit" form="post-form">保存文章 <svg><use href="/assets/images/icons.svg#icon-check"></use></svg></button>
  </div>
</div>

<form class="editor-form" id="post-form" action="<%= post ? `/admin/posts/${post.id}` : '/admin/posts' %>" method="post" data-editor-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="editor-layout">
    <div class="editor-main">
      <section class="editor-title-card">
        <label class="sr-only" for="post-title">文章标题</label>
        <input id="post-title" class="editor-title-input" type="text" name="title" value="<%= post ? post.title : '' %>" required maxlength="255" placeholder="给这篇文章一个标题" data-title-input>
        <div class="slug-field">
          <span>文章地址</span>
          <span>/posts/</span>
          <input type="text" name="slug" value="<%= post ? post.slug : '' %>" maxlength="190" placeholder="auto-generated-slug" data-slug-input>
        </div>
      </section>

      <section class="editor-content-card">
        <div class="markdown-toolbar" role="toolbar" aria-label="Markdown 工具栏">
          <button type="button" data-md-insert="**粗体**" title="粗体"><svg><use href="/assets/images/icons.svg#icon-bold"></use></svg></button>
          <button type="button" data-md-insert="*斜体*" title="斜体"><svg><use href="/assets/images/icons.svg#icon-italic"></use></svg></button>
          <span></span>
          <button type="button" data-md-prefix="## " title="二级标题">H2</button>
          <button type="button" data-md-prefix="### " title="三级标题">H3</button>
          <button type="button" data-md-insert="> 引用文字" title="引用"><svg><use href="/assets/images/icons.svg#icon-quote"></use></svg></button>
          <button type="button" data-md-insert="`inline code`" title="行内代码"><svg><use href="/assets/images/icons.svg#icon-code"></use></svg></button>
          <button type="button" data-md-insert="```ts&#10;code here&#10;```" title="代码块"><svg><use href="/assets/images/icons.svg#icon-code"></use></svg></button>
          <button type="button" data-md-prefix="- " title="列表"><svg><use href="/assets/images/icons.svg#icon-list"></use></svg></button>
          <button type="button" data-md-insert="[链接文字](https://example.com)" title="链接"><svg><use href="/assets/images/icons.svg#icon-link"></use></svg></button>
          <div class="editor-tabs" role="tablist" aria-label="编辑器视图">
            <button type="button" class="is-active" data-editor-tab="write">写作</button>
            <button type="button" data-editor-tab="preview">预览</button>
          </div>
        </div>
        <div class="editor-write-pane" data-write-pane>
          <label class="sr-only" for="post-content">文章正文</label>
          <textarea id="post-content" name="content" required rows="26" placeholder="用 Markdown 开始写作…" data-content-input><%= post ? post.content : '' %></textarea>
        </div>
        <div class="editor-preview-pane prose" data-preview-pane hidden>
          <div class="preview-placeholder">加载预览…</div>
        </div>
      </section>

      <section class="editor-meta-fields">
        <label class="field"><span>摘要</span><textarea name="excerpt" rows="3" maxlength="500" placeholder="不填会根据正文自动生成"><%= post ? post.excerpt : '' %></textarea><small>用于列表页、SEO 与社交分享。</small></label>
      </section>
    </div>

    <aside class="editor-sidebar">
      <section class="editor-side-card">
        <div class="side-card-heading"><span>发布</span><span class="status-badge status-<%= post ? post.status : 'draft' %>"><%= post ? (post.status === 'published' ? '已发布' : post.status === 'draft' ? '草稿' : '已归档') : '新草稿' %></span></div>
        <label class="field compact"><span>状态</span>
          <select name="status">
            <option value="draft" <%= post && post.status === 'draft' ? 'selected' : '' %>>草稿</option>
            <option value="published" <%= post && post.status === 'published' ? 'selected' : '' %>>发布</option>
            <option value="archived" <%= post && post.status === 'archived' ? 'selected' : '' %>>归档</option>
          </select>
        </label>
        <label class="field compact"><span>发布时间</span><input type="datetime-local" name="published_at" value="<%= post && post.published_at ? post.published_at.slice(0, 16).replace(' ', 'T') : '' %>"><small>留空则在首次发布时自动写入。</small></label>
        <label class="check-field"><input type="checkbox" name="featured" <%= post && post.featured ? 'checked' : '' %>><span><strong>置顶推荐</strong><small>出现在首页精选区域</small></span></label>
        <label class="check-field"><input type="checkbox" name="allow_comments" <%= !post || post.allow_comments ? 'checked' : '' %>><span><strong>允许评论</strong><small>读者可以在文章下留言</small></span></label>
        <div class="editor-submit-row">
          <button class="button button-primary" type="submit">保存文章</button>
        </div>
      </section>

      <section class="editor-side-card">
        <div class="side-card-heading"><span>组织</span></div>
        <label class="field compact"><span>分类</span>
          <select name="category_id">
            <option value="">未分类</option>
            <% categories.forEach(category => { %><option value="<%= category.id %>" <%= post && post.category_id === category.id ? 'selected' : '' %>><%= category.name %></option><% }) %>
          </select>
        </label>
        <label class="field compact"><span>标签</span><input type="text" name="tags" value="<%= post ? post.tagsText : '' %>" placeholder="TypeScript, 设计, 随笔"><small>用逗号分隔，最多 12 个。</small></label>
        <% if (tagSuggestions.length) { %>
        <div class="tag-suggestions"><% tagSuggestions.slice(0, 10).forEach(tag => { %><button type="button" data-tag-suggestion="<%= tag.name %>"><%= tag.name %></button><% }) %></div>
        <% } %>
      </section>

      <section class="editor-side-card">
        <div class="side-card-heading"><span>封面</span></div>
        <label class="field compact"><span>封面图片地址</span><input type="url" name="cover_url" value="<%= post && post.cover_url ? post.cover_url : '' %>" placeholder="https://…"><small>留空会使用自动生成的抽象封面。</small></label>
        <div class="cover-preview"><span>自动封面预览</span><i><%= post ? post.title.slice(0, 1) : '文' %></i></div>
      </section>
    </aside>
  </div>
</form>
