<div class="admin-page-head">
  <div><p class="eyebrow"><span></span> SMALL WEB</p><h1>友链</h1><p>维护那些真实访问、也愿意推荐的站点。</p></div>
</div>

<section class="admin-panel link-create-panel">
  <div class="panel-heading"><div><span class="mini-label">ADD A LINK</span><h2>添加友链</h2></div></div>
  <form action="/admin/links" method="post" class="link-create-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="create-grid">
      <label class="field compact"><span>站点名称</span><input type="text" name="name" required maxlength="100" placeholder="站点名称"></label>
      <label class="field compact"><span>网址</span><input type="url" name="url" required maxlength="500" placeholder="https://example.com"></label>
      <label class="field compact"><span>主题色</span><input type="color" name="color" value="#0a8a4e"></label>
    </div>
    <label class="field compact"><span>一句话介绍</span><input type="text" name="description" maxlength="300" placeholder="这个站点有什么值得看的"></label>
    <div class="create-form-footer">
      <label class="check-field inline"><input type="checkbox" name="visible" checked><span><strong>公开展示</strong></span></label>
      <button class="button button-primary button-small" type="submit"><svg><use href="/assets/images/icons.svg#icon-plus"></use></svg>添加友链</button>
    </div>
  </form>
</section>

<div class="link-admin-list">
  <% links.forEach(link => { %>
  <form class="admin-panel link-admin-item" action="/admin/links/<%= link.id %>" method="post">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <span class="link-admin-avatar" style="--accent: <%= link.color %>"><% if (link.avatar_url) { %><img src="<%= safeExternalUrl(link.avatar_url) %>" alt=""><% } else { %><%= link.name.slice(0, 1) %><% } %></span>
    <div class="link-admin-fields">
      <div class="create-grid">
        <label class="field compact"><span>名称</span><input type="text" name="name" value="<%= link.name %>" required></label>
        <label class="field compact"><span>网址</span><input type="url" name="url" value="<%= link.url %>" required></label>
        <label class="field compact"><span>排序</span><input type="number" name="sort_order" value="<%= link.sort_order %>"></label>
      </div>
      <label class="field compact"><span>介绍</span><input type="text" name="description" value="<%= link.description || '' %>"></label>
      <label class="field compact"><span>头像</span><input type="url" name="avatar_url" value="<%= link.avatar_url || '' %>" placeholder="可选"></label>
    </div>
    <div class="link-admin-side">
      <input type="color" name="color" value="<%= link.color %>" aria-label="主题色">
      <label class="check-field inline"><input type="checkbox" name="visible" <%= link.visible ? 'checked' : '' %>><span><strong>显示</strong></span></label>
      <button class="button button-primary button-small" type="submit">保存</button>
      <button class="button button-danger-quiet button-small" type="submit" formaction="/admin/links/<%= link.id %>/delete" data-confirm="确定删除这个友链吗？">删除</button>
    </div>
  </form>
  <% }) %>
</div>
