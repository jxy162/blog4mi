<section class="hero shell">
  <div class="hero-copy">
    <p class="eyebrow hero-kicker" data-reveal><span></span><%= settings.hero_kicker %></p>
    <h1 data-reveal>
      <span><%= settings.hero_title %></span>
      <em><%= settings.hero_highlight %></em>
    </h1>
    <p class="hero-description" data-reveal><%= settings.hero_text %></p>
    <div class="hero-actions" data-reveal>
      <a class="button button-primary" href="/posts">开始阅读 <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg></a>
      <a class="button button-quiet" href="/about">关于这个博客</a>
    </div>
    <dl class="hero-stats" data-reveal>
      <div><dt><%= stats.posts %></dt><dd>篇文章</dd></div>
      <div><dt><%= stats.categories %></dt><dd>个主题</dd></div>
      <div><dt><%= Math.max(1, Math.round(stats.words / 1000)) %>k</dt><dd>字积累</dd></div>
    </dl>
  </div>

  <div class="hero-stage-wrap" data-reveal>
    <figure class="hero-stage" aria-label="博客视觉卡片">
      <span class="stage-halo" aria-hidden="true"></span>
      <div class="stage-card">
        <div class="stage-topline">
          <span>FIELD NOTE / 008</span>
          <span class="stage-live"><i></i> ACTIVE</span>
        </div>
        <div class="stage-art" aria-hidden="true">
          <svg viewBox="0 0 360 210">
            <path d="M28 184C112 165 147 87 207 27c18-18 43-22 70-12 25 9 43 31 48 56" fill="none" stroke="currentColor" stroke-width="1.2" stroke-dasharray="4 7"/>
            <circle cx="28" cy="184" r="6" fill="currentColor"/>
            <circle cx="325" cy="71" r="10" fill="#ff8f64"/>
            <path d="M160 95c24 2 41-8 52-31-23-2-43 8-52 31Z" fill="#d9f8e6"/>
            <path d="M160 95c17-12 31-22 52-31" fill="none" stroke="#0a8a4e" stroke-width="2"/>
          </svg>
          <span class="stage-grid"></span>
        </div>
        <blockquote>Make room<br>for <em>thought.</em></blockquote>
        <div class="stage-footer">
          <span>DESIGN · CODE · LIFE</span>
          <span>2026—</span>
        </div>
      </div>
      <div class="floating-note" aria-hidden="true">
        <span>本周</span>
        <strong>保持具体</strong>
      </div>
      <div class="floating-seal" aria-hidden="true">
        <span>M3E</span>
        <small>FIELD<br>NOTES</small>
      </div>
      <figcaption>把想法留下来，不让它只停在浏览器标签页里。</figcaption>
    </figure>
  </div>
</section>

<section class="section shell featured-section">
  <div class="section-heading" data-reveal>
    <div>
      <p class="eyebrow"><span></span> 置顶阅读</p>
      <h2>先从这一篇开始</h2>
    </div>
    <a class="text-link" href="/archives">全部归档 <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg></a>
  </div>

  <% if (featured) { %>
  <article class="featured-card" data-reveal style="--accent: <%= featured.category_color || '#0a8a4e' %>">
    <div class="featured-copy">
      <div class="post-card-meta">
        <span class="category-chip category-chip-light"><i></i><%= featured.category_name || '未分类' %></span>
        <span><%= formatDate(featured.published_at, 'long') %></span>
      </div>
      <h3><a href="/posts/<%= featured.slug %>"><%= featured.title %></a></h3>
      <p><%= featured.excerpt %></p>
      <div class="featured-tags">
        <% featured.tags.slice(0, 3).forEach(tag => { %><a href="/posts?tag=<%= tag.slug %>">#<%= tag.name %></a><% }) %>
      </div>
      <div class="featured-bottom">
        <a class="button button-light" href="/posts/<%= featured.slug %>">阅读全文 <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg></a>
        <span><svg><use href="/assets/images/icons.svg#icon-clock"></use></svg><%= featured.reading_time %> 分钟阅读</span>
      </div>
    </div>
    <div class="featured-art" aria-hidden="true">
      <span class="feature-art-grid"></span>
      <span class="feature-art-ring ring-one"></span>
      <span class="feature-art-ring ring-two"></span>
      <span class="feature-art-disc"></span>
      <span class="feature-art-letter"><%= featured.title.slice(0, 1) %></span>
      <div class="feature-art-caption">
        <span>SELECTED WRITING</span>
        <strong><%= String(stats.posts).padStart(2, '0') %></strong>
      </div>
    </div>
  </article>
  <% } else { %>
  <div class="empty-state"><p>第一篇文章正在路上。</p></div>
  <% } %>
</section>

<section class="section shell latest-section">
  <div class="section-heading" data-reveal>
    <div>
      <p class="eyebrow"><span></span> 最近写下</p>
      <h2>新的思考与记录</h2>
    </div>
    <a class="text-link" href="/posts">查看全部 <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg></a>
  </div>
  <% if (posts.length) { %>
  <div class="post-grid">
    <% for (const [index, post] of posts.entries()) { %><%- await include('partials/post-card', { post, index }) %><% } %>
  </div>
  <% } else { %>
  <div class="empty-state"><p>还没有发布文章，第一篇文章正在路上。</p></div>
  <% } %>
</section>

<section class="section shell topics-section">
  <div class="section-heading" data-reveal>
    <div>
      <p class="eyebrow"><span></span> 按主题漫游</p>
      <h2>从兴趣出发，而不是从时间线</h2>
    </div>
  </div>
  <div class="topic-layout">
    <div class="topic-grid">
      <% if (categories.length) { %>
      <% categories.forEach((category, index) => { %>
      <a class="topic-card" href="/posts?category=<%= category.slug %>" data-reveal style="--accent: <%= category.color %>">
        <span class="topic-number"><%= String(index + 1).padStart(2, '0') %></span>
        <span class="topic-orb"></span>
        <div>
          <h3><%= category.name %></h3>
          <p><%= category.description %></p>
        </div>
        <span class="topic-count"><%= category.post_count %> 篇 <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg></span>
      </a>
      <% }) %>
      <% } else { %>
      <div class="empty-state"><p>还没有创建分类。</p></div>
      <% } %>
    </div>
    <aside class="tag-panel" data-reveal>
      <div class="tag-panel-heading">
        <span class="mini-label"><svg><use href="/assets/images/icons.svg#icon-tag"></use></svg> KEYWORDS</span>
        <h3>从关键词开始</h3>
      </div>
      <div class="tag-cloud">
        <% if (tags.length) { %>
        <% tags.forEach((tag, index) => { %>
        <a href="/posts?tag=<%= tag.slug %>" class="<%= index < 3 ? 'tag-large' : '' %>"><%= tag.name %><sup><%= tag.post_count %></sup></a>
        <% }) %>
        <% } else { %>
        <p class="tag-empty">还没有标签。</p>
        <% } %>
      </div>
      <a class="text-link tag-all" href="/tags">标签索引 <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg></a>
    </aside>
  </div>
</section>

<section class="section shell about-strip" data-reveal>
  <div class="about-strip-art" aria-hidden="true">
    <span class="strip-circle"></span>
    <span class="strip-square"></span>
    <span class="strip-letter"><%= settings.author_name.slice(0, 1) %></span>
  </div>
  <div class="about-strip-copy">
    <p class="eyebrow"><span></span> 关于写作者</p>
    <h2>在构建中理解世界，<br>在书写中理解自己。</h2>
    <p><%= settings.author_bio %></p>
    <a class="button button-primary" href="/about">认识我 <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg></a>
  </div>
  <a class="strip-stat" href="/about">
    <strong><%= stats.comments %></strong>
    <span>次公开回应</span>
    <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg>
  </a>
</section>
