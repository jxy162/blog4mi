<header class="site-header" data-site-header>
  <div class="shell site-header-inner">
    <a class="brand" href="/" aria-label="<%= settings.site_title %> 首页">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 64 64"><path d="M16 48c15-2 25-11 29-34-15 2-26 12-29 34Z"/><path class="brand-stem" d="M16 48c10-10 19-19 29-34"/><circle cx="48" cy="48" r="7"/></svg>
      </span>
      <span class="brand-copy">
        <strong><%= settings.site_title %></strong>
        <small><%= settings.site_subtitle %></small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="主导航">
      <a class="nav-link <%= currentPath === '/' ? 'is-active' : '' %>" href="/">首页</a>
      <a class="nav-link <%= currentPath.startsWith('/posts') || currentPath.startsWith('/archives') ? 'is-active' : '' %>" href="/posts">文章</a>
      <a class="nav-link <%= currentPath.startsWith('/categories') || currentPath.startsWith('/tags') ? 'is-active' : '' %>" href="/categories">主题</a>
      <a class="nav-link <%= currentPath.startsWith('/about') ? 'is-active' : '' %>" href="/about">关于</a>
      <a class="nav-link <%= currentPath.startsWith('/links') ? 'is-active' : '' %>" href="/links">友链</a>
    </nav>

    <div class="header-actions">
      <a class="icon-button header-search" href="/posts" aria-label="搜索文章" title="搜索文章">
        <svg><use href="/assets/images/icons.svg#icon-search"></use></svg>
      </a>
      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="切换深浅色主题" title="切换主题">
        <svg class="theme-icon theme-icon-sun"><use href="/assets/images/icons.svg#icon-sun"></use></svg>
        <svg class="theme-icon theme-icon-moon"><use href="/assets/images/icons.svg#icon-moon"></use></svg>
      </button>
      <% if (currentUser) { %>
        <a class="header-cta" href="/admin">工作台 <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg></a>
      <% } else { %>
        <a class="header-cta" href="/admin/login">登录</a>
      <% } %>
      <button class="icon-button mobile-menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu" aria-label="打开菜单">
        <svg class="menu-open-icon"><use href="/assets/images/icons.svg#icon-menu"></use></svg>
        <svg class="menu-close-icon"><use href="/assets/images/icons.svg#icon-x"></use></svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="shell mobile-menu-inner">
      <nav aria-label="移动端导航">
        <a href="/"><span>首页</span><small>HOME</small></a>
        <a href="/posts"><span>文章</span><small>WRITING</small></a>
        <a href="/archives"><span>归档</span><small>ARCHIVE</small></a>
        <a href="/categories"><span>主题</span><small>TOPICS</small></a>
        <a href="/about"><span>关于</span><small>ABOUT</small></a>
        <a href="/links"><span>友链</span><small>LINKS</small></a>
      </nav>
      <a class="button button-primary" href="<%= currentUser ? '/admin' : '/admin/login' %>">
        <%= currentUser ? '进入工作台' : '登录后台' %>
        <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg>
      </a>
    </div>
  </div>
</header>
