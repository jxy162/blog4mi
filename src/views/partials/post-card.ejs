<article class="post-card" data-reveal style="--accent: <%= post.category_color || '#0a8a4e' %>">
  <a class="post-card-link" href="/posts/<%= post.slug %>">
    <div class="post-card-visual <%= post.cover_url ? 'has-image' : '' %>">
      <% if (post.cover_url) { %>
        <img src="<%= safeExternalUrl(post.cover_url) %>" alt="" loading="lazy">
      <% } else { %>
        <span class="visual-grid" aria-hidden="true"></span>
        <span class="visual-orb" aria-hidden="true"></span>
        <span class="visual-word" aria-hidden="true"><%= post.title.slice(0, 1) %></span>
        <span class="visual-line" aria-hidden="true"></span>
        <span class="visual-dot" aria-hidden="true"></span>
      <% } %>
      <% if (post.featured) { %><span class="post-card-featured">置顶</span><% } %>
    </div>
    <div class="post-card-body">
      <div class="post-card-meta">
        <span class="category-chip"><i></i><%= post.category_name || '未分类' %></span>
        <span><%= formatDate(post.published_at) %></span>
      </div>
      <h3><%= post.title %></h3>
      <p><%= post.excerpt %></p>
      <div class="post-card-footer">
        <span><svg><use href="/assets/images/icons.svg#icon-clock"></use></svg><%= post.reading_time %> 分钟</span>
        <span class="read-more">阅读 <svg><use href="/assets/images/icons.svg#icon-arrow"></use></svg></span>
      </div>
    </div>
  </a>
</article>
